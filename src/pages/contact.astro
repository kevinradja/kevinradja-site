---
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
---
<Base lang="fr" title="Contact | Kevin Radja" description="Réservez un appel de 30 min ou écrivez-moi : réponse sous 48 à 72 h.">
<section class="sec" style="padding-top:clamp(36px,5vw,64px)"><div class="wrap">
  <div class="head"><div><div class="kicker">Contact</div><h1 class="pg-title">Parlons de votre projet.</h1></div><p class="mute">30 minutes, sans engagement : on regarde votre fichier ensemble et je vous dis quelle offre convient.</p></div>
  <div class="ct-av"><img src="/avatar.svg" alt="" width="400" height="400" /><span class="deal-bubble">À tout de suite !</span></div>
  <ContactCard lang="fr" />
</div></section>
</Base>
