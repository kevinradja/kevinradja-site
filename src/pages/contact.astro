---
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
---
<Base lang="fr" title="Contact | Kevin Radja" description="Écrivez-moi ou réservez un échange de 30 min : data, dashboards, reporting, IA.">
<section class="sec" style="padding-top:clamp(36px,5vw,64px)"><div class="wrap">
  <div class="head"><div><div class="kicker">Contact</div><h1 class="pg-title">Parlons data.</h1></div><p class="mute">Une question sur un tableau de bord, un reporting ou un projet data ? Écrivez-moi, je réponds avec plaisir.</p></div>
  <div class="ct-av"><img src="/avatar.svg" alt="" width="400" height="400" /><span class="deal-bubble">À tout de suite !</span></div>
  <ContactCard lang="fr" />
</div></section>
</Base>
