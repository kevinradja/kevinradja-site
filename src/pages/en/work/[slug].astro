---
import Base from '../../../layouts/Base.astro';
import ProjectPage from '../../../components/ProjectPage.astro';
import { projects } from '../../../data/projects';
export function getStaticPaths() { return projects.map(p => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
---
<Base lang="en" title={`${p.title.en} | Kevin Radja`} description={p.intro.en} image={p.thumb}><ProjectPage p={p} lang="en" /></Base>
