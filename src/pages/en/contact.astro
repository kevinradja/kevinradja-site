---
import Base from '../../layouts/Base.astro';
import ContactCard from '../../components/ContactCard.astro';
---
<Base lang="en" title="Contact | Kevin Radja" description="Write to me or book a 30-min chat: data, dashboards, reporting, AI.">
<section class="sec" style="padding-top:clamp(36px,5vw,64px)"><div class="wrap">
  <div class="head"><div><div class="kicker">Contact</div><h1 class="pg-title">Let’s talk data.</h1></div><p class="mute">A question about a dashboard, reporting or a data project? Drop me a line, happy to chat.</p></div>
  <div class="ct-av"><img src="/avatar.svg" alt="" width="400" height="400" /><span class="deal-bubble">Talk soon!</span></div>
  <ContactCard lang="en" />
</div></section>
</Base>
