        function z(){var vh=innerHeight;zs.forEach(function(e){var r=e.getBoundingClientRect(),p=Math.min(1,Math.max(0,(vh-r.top)/(vh*.85)));e.style.setProperty('--z',p.toFixed(3))})}
        if(zs.length){addEventListener('scroll',z,{passive:true});addEventListener('resize',z);z()}
        document.querySelectorAll('.c-hero-l b,.stats b').forEach(function(b){var m=b.textContent.match(/^(\d(?:[\d\u00a0\u202f ]*\d)?)(.*)$/);if(!m)return;var to=parseInt(m[1].replace(/\D/g,''),10);if(!to)return;
          b.dataset.count=1;b._to=to;b._suf=m[2];b._fmt=/\s|\u00a0|\u202f/.test(m[1].trim());io2.observe(b)});
        var cio=new IntersectionObserver(function(es){es.forEach(function(x){if(!x.isIntersecting)return;cio.unobserve(x.target);var b=x.target,t0=performance.now(),d=1400;
          (function st(t){var p=Math.min(1,(t-t0)/d),v=Math.round(b._to*(1-Math.pow(1-p,3)));b.textContent=(b._fmt?v.toLocaleString('fr-FR'):v)+b._suf;if(p<1)requestAnimationFrame(st)})(t0)})},{threshold:.6});
        document.querySelectorAll('[data-count]').forEach(function(b){if(b._to)cio.observe(b)});
        if(matchMedia('(hover:hover)').matches)document.querySelectorAll('.pc').forEach(function(c){
          c.addEventListener('mousemove',function(e){var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform='perspective(900px) rotateY('+(x*8)+'deg) rotateX('+(-y*8)+'deg) translateY(-4px)'});
          c.addEventListener('mouseleave',function(){c.style.transform=''})});
        /* the avatar thinks, winks while dealing, then smiles */
        window.krDeal=function(d){var im=d.querySelector('.deal-av img'),bb=d.querySelector('.deal-bubble');if(!im)return;
          setTimeout(function(){im.src='/avatar-wink.svg';if(bb)bb.textContent=bb.dataset.b;d.classList.add('in');if(window.KR&&KR.sfx)KR.sfx.play('stage1')},900);
          setTimeout(function(){im.src='/avatar.svg';if(bb)bb.textContent=bb.dataset.c},2300)};
        ['/avatar-wink.svg','/avatar.svg'].forEach(function(u){var i=new Image();i.src=u});
        var dl=document.querySelector('.deal:not(.in)');if(dl&&!document.querySelector('.c-hero')){var dio=new IntersectionObserver(function(es){if(es[0].isIntersecting){dl.classList.add('go');krDeal(dl);dio.disconnect()}},{threshold:.2});dio.observe(dl)}
      })();
      /* fit giant one-line words to their container so nothing overflows */
      (function(){var els=[].slice.call(document.querySelectorAll('.c-giant,.foot-giant,.c-big,.pj-next-t'));if(!els.length)return;
        function fit(){els.forEach(function(e){e.style.fontSize='';var par=e.parentElement,cs=getComputedStyle(par),w=par.clientWidth-parseFloat(cs.paddingLeft)-parseFloat(cs.paddingRight);
          var nw=getComputedStyle(e).whiteSpace==='nowrap';if(!nw)return;var sw=e.scrollWidth;if(sw>w&&w>0){var f=parseFloat(getComputedStyle(e).fontSize);e.style.fontSize=Math.floor(f*w/sw*0.97)+'px'}})}
        var t;addEventListener('resize',function(){clearTimeout(t);t=setTimeout(fit,120)});
        if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);addEventListener('load',fit);fit();
        document.querySelectorAll('.c-slider button').forEach(function(b){b.addEventListener('click',function(){setTimeout(fit,30)})});setInterval(function(){if(document.querySelector('.c-slide-txt.on'))fit()},6100)})();
      window.addEventListener('message',function(e){if(e.data&&e.data.krHeight){document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=Math.ceil(e.data.krHeight)+'px'})}});
    })();
  </script>
</body>
</html>
