---
import '../styles/global.css';
import type { Lang } from '../data/projects';
import { r, altPath, ui, calendly, links } from '../i18n';
interface Props { lang: Lang; title: string; description: string; bare?: boolean; image?: string; path?: string }
const { lang, title, description, bare = false, image = '/og.png' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const other = altPath(path, lang);
const intro = !bare && (path === '/' || path === '/en/');
const site = Astro.site?.origin ?? '';
const nav = [
  { k: 'work', h: r('work', lang) }, { k: 'pricing', h: r('pricing', lang) }, { k: 'about', h: r('about', lang) }, { k: 'game', h: r('game', lang) }, { k: 'contact', h: r('contact', lang) },
] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + path} />
  <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={site + other} />
  <link rel="alternate" hreflang={lang} href={site + path} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + image} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {intro && <script is:inline>
    /* Entry animation (home only): once per browser session, skipped for reduced motion. */
    (function(){try{var force=/[?&]intro(=|&|$)/.test(location.search);if(!force&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;if(!force&&sessionStorage.getItem('kr-intro'))return;sessionStorage.setItem('kr-intro','1');document.documentElement.classList.add('warp')}catch(e){}})();
  </script>}
  <script is:inline>
    (function(){try{var t=localStorage.getItem('kr-theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t);if(localStorage.getItem('kr-sound')==='off')document.documentElement.classList.add('muted')}catch(e){}})();
  </script>
</head>
<body>
  {intro && (
  <div id="warp" aria-hidden="true"><canvas></canvas><div class="wl"><span>KR<i>.csv</i></span></div></div>
  )}
  {!bare && (
  <header class="nav" id="nav">
    <div class="wrap in">
      <a class="logo" href={r('home', lang)} aria-label="Kevin Radja">KR<i>.csv</i></a>
      <nav class="links">
        {nav.map(n => <a class:list={['l', { on: path.startsWith(n.h) && n.h !== '/' }]} href={n.h}>{ui.nav[n.k][lang]}</a>)}
      </nav>
      <a class="ic" href={other} title={lang === 'fr' ? 'English version' : 'Version française'}>{lang === 'fr' ? 'EN' : 'FR'}</a>
      <button class="ic" id="theme" aria-label={ui.theme[lang]} title={ui.theme[lang]}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="ic" id="sound" data-silent aria-label={ui.sound[lang]} title={ui.sound[lang]}>
        <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>
        <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
      </button>
      <a class="li" href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        <span>LinkedIn</span>
      </a>
      <a class="btn p sm cta" href={calendly} target="_blank" rel="noopener">{ui.nav.cta[lang]}</a>
      <button class="ic burger" id="burger" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </header>
  )}
  <main><slot /></main>
  {!bare && (
  <footer class="foot">
    <div class="wrap in">
      <div><b style="color:var(--ink)">Kevin Radja</b> · {ui.footer.line[lang]}<br /><span style="font-size:12.5px">{ui.footer.siret[lang]}</span></div>
      <div class="links">
        <a href={r('work', lang)}>{ui.nav.work[lang]}</a><a href={r('pricing', lang)}>{ui.nav.pricing[lang]}</a><a href={r('contact', lang)}>{ui.nav.contact[lang]}</a>
        <a href={r('legal', lang)}>{ui.footer.legal[lang]}</a><a href={r('privacy', lang)}>{ui.footer.privacy[lang]}</a>
      </div>
      <div>© {new Date().getFullYear()} Kevin Radja</div>
    </div>
  </footer>
  )}
  {intro && <script is:inline>
    (function(){
      var root=document.documentElement,w=document.getElementById('warp');if(!w)return;
      if(!root.classList.contains('warp')){w.remove();return}
      var c=w.querySelector('canvas'),x=c.getContext('2d'),W,H,dpr=Math.min(2,window.devicePixelRatio||1),S=[],t0=performance.now(),done=false;
      function rs(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0)}rs();addEventListener('resize',rs);
      function star(z){return{x:(Math.random()-.5)*2,y:(Math.random()-.5)*2,z:z||Math.random()*1+.05,c:Math.random()<.25?'#3FD3DC':'#fff'}}
      for(var i=0;i<520;i++)S.push(star());
      var WARP=1500,SPLASH=650;
      function end(){if(done)return;done=true;root.classList.remove('warp');root.classList.add('warp-in');w.remove();setTimeout(function(){root.classList.remove('warp-in')},800)}
      w.addEventListener('click',function(){t0=performance.now()-WARP});addEventListener('keydown',function(){if(!done)t0=performance.now()-WARP},{once:true});
      function f(now){if(done)return;var t=now-t0,p=Math.min(1,t/WARP),sp=.004+Math.pow(p,3)*.09;
        x.fillStyle='rgba(5,7,13,'+(p<.9?.35:.6)+')';x.fillRect(0,0,W,H);
        var cx=W/2,cy=H/2,k=Math.max(W,H)*.5;
        for(var i=0;i<S.length;i++){var s=S[i],px=cx+s.x/s.z*k,py=cy+s.y/s.z*k;s.z-=sp;if(s.z<=.02){S[i]=star(1);continue}
          var nx=cx+s.x/s.z*k,ny=cy+s.y/s.z*k;x.strokeStyle=s.c;x.globalAlpha=Math.min(1,(1-s.z)*1.4);x.lineWidth=Math.min(3,(1-s.z)*2.6);x.beginPath();x.moveTo(px,py);x.lineTo(nx,ny);x.stroke()}
        x.globalAlpha=1;
        if(t>WARP){var q=Math.min(1,(t-WARP)/SPLASH),e=1-Math.pow(1-q,3),R=e*Math.hypot(W,H)*.6;
          w.style.webkitMaskImage=w.style.maskImage='radial-gradient(circle at 50% 50%, transparent '+R+'px, #000 '+(R+2)+'px)';
          for(var j=0;j<3;j++){var r2=R*(1+j*.18)+4;x.strokeStyle='rgba(63,211,220,'+(1-q)*(.9-j*.25)+')';x.lineWidth=6-j*2;x.beginPath();x.arc(cx,cy,r2,0,7);x.stroke()}
          if(q>=1)return end()}
        requestAnimationFrame(f)}
      requestAnimationFrame(f);setTimeout(end,WARP+SPLASH+1500);
    })();
  </script>}
  <script is:inline src="/sfx.js"></script>
  <script is:inline>
    (function(){
      var root=document.documentElement;
      function cur(){return root.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}
      function paint(){
        document.querySelectorAll('iframe').forEach(function(f){try{f.contentWindow.postMessage({krTheme:cur()},'*')}catch(e){}})}
      var b=document.getElementById('theme');if(b)b.onclick=function(){var n=cur()==='dark'?'light':'dark';root.setAttribute('data-theme',n);try{localStorage.setItem('kr-theme',n)}catch(e){}paint()};
      paint();
      var sb=document.getElementById('sound');function ps(){var m=window.KR&&KR.sfx&&KR.sfx.isMuted();root.classList.toggle('muted',!!m);
        document.querySelectorAll('iframe').forEach(function(f){try{f.contentWindow.postMessage({krSound:m?'off':'on'},'*')}catch(e){}})}
      if(sb)sb.onclick=function(){if(!window.KR||!KR.sfx)return;var m=!KR.sfx.isMuted();KR.sfx.mute(m);if(!m)KR.sfx.play('toggle');ps()};ps();
      var bg=document.getElementById('burger'),nv=document.getElementById('nav');if(bg)bg.onclick=function(){nv.classList.toggle('open')};
      var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.1});
      document.querySelectorAll('.rv').forEach(function(e){io.observe(e)});
      window.addEventListener('message',function(e){if(e.data&&e.data.krHeight){document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=Math.ceil(e.data.krHeight)+'px'})}});
    })();
  </script>
</body>
</html>
