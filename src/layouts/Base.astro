---
import '../styles/global.css';
import type { Lang } from '../data/projects';
import { r, altPath, ui, calendly, links } from '../i18n';
interface Props { lang: Lang; title: string; description: string; bare?: boolean; image?: string; path?: string }
const { lang, title, description, bare = false, image = '/og.png' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const other = altPath(path, lang);
const intro = !bare && (path === '/' || path === '/en/');
const site = Astro.site?.origin ?? '';
const nav = [
  { k: 'work', h: r('work', lang) }, { k: 'pricing', h: r('pricing', lang) }, { k: 'about', h: r('about', lang) }, { k: 'game', h: r('game', lang) }, { k: 'contact', h: r('contact', lang) },
] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + path} />
  <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={site + other} />
  <link rel="alternate" hreflang={lang} href={site + path} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + image} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Press+Start+2P&display=swap" rel="stylesheet" />
  {intro && <script is:inline>
    /* Entry animation (home only): once per browser session, skipped for reduced motion. */
    (function(){try{var force=/[?&]intro(=|&|$)/.test(location.search);if(!force&&sessionStorage.getItem('kr-intro'))return;sessionStorage.setItem('kr-intro','1');document.documentElement.classList.add('warp')}catch(e){}})();
  </script>}
  <script is:inline>
    /* always start at the top after a reload (unless the URL targets a section) */
    (function(){try{if('scrollRestoration' in history)history.scrollRestoration='manual';if(!location.hash){window.scrollTo(0,0);addEventListener('load',function(){window.scrollTo(0,0)})}}catch(e){}})();
    (function(){try{var t=localStorage.getItem('kr-theme');document.documentElement.setAttribute('data-theme',(t==='dark'||t==='light')?t:'dark');if(localStorage.getItem('kr-sound')==='off')document.documentElement.classList.add('muted')}catch(e){}})();
  </script>
</head>
<body>
  {intro && (
  <div id="warp" aria-hidden="true"><canvas></canvas>
    <div class="wsc">
      <p class="wq" data-t={lang === 'fr' ? 'On veut décider avec la donnée ?' : 'Want to decide with data?'}></p>
      <div class="wdev"><div class="wscr">
        <div class="wmess">
          <div class="wt" style="--r:-5deg"><small>CA ???</small><b class="bad">#N/A</b></div>
          <div class="wt" style="--r:4deg"><small>CLIENTS</small><b>12O</b></div>
          <div class="wt" style="--r:-2deg"><small>MARGE</small><b class="bad">ERR!</b></div>
          <div class="wbars" style="--r:3deg"><i style="height:30%"></i><i style="height:85%"></i><i style="height:12%"></i><i class="bad" style="height:60%"></i><i style="height:44%"></i><i style="height:95%"></i></div>
          <div class="wnote" style="--r:-7deg">v3_FINAL(2).xlsx</div>
        </div>
        <div class="wclean">
          <div class="wc-h"><b>{lang === 'fr' ? 'Tableau de bord' : 'Dashboard'}</b><span>● live</span></div>
          <div class="wc-k"><div><small>{lang === 'fr' ? 'CA du mois' : 'Revenue'}</small><b>48,2 k€</b><em>▲ 12 %</em></div><div><small>Clients</small><b>128</b><em>▲ 9</em></div><div><small>{lang === 'fr' ? 'Marge' : 'Margin'}</small><b>31 %</b><em>▲ 2 pts</em></div></div>
          <div class="wc-c"><svg viewBox="0 0 200 70" preserveAspectRatio="none"><polyline fill="none" stroke="#0E5257" stroke-width="3" stroke-linejoin="round" points="0,58 25,52 50,55 75,42 100,44 125,32 150,26 175,18 200,10"/><polyline fill="none" stroke="#9FD3CC" stroke-width="1.5" stroke-dasharray="4 4" points="0,46 200,46"/></svg><svg viewBox="0 0 42 42" class="wc-d"><circle cx="21" cy="21" r="15.9" fill="none" stroke="#E8E1D3" stroke-width="6"/><circle cx="21" cy="21" r="15.9" fill="none" stroke="#0E5257" stroke-width="6" stroke-dasharray="64 36" transform="rotate(-90 21 21)"/><circle cx="21" cy="21" r="15.9" fill="none" stroke="#2A8C8C" stroke-width="6" stroke-dasharray="22 78" stroke-dashoffset="-64" transform="rotate(-90 21 21)"/></svg></div>
        </div>
