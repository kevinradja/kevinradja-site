---
import '../styles/global.css';
import type { Lang } from '../data/projects';
import { r, altPath, ui, calendly, links } from '../i18n';
interface Props { lang: Lang; title: string; description: string; bare?: boolean; image?: string; path?: string }
const { lang, title, description, bare = false, image = '/og.png' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const other = altPath(path, lang);
const intro = !bare && (path === '/' || path === '/en/');
const site = Astro.site?.origin ?? '';
const nav = [
  { k: 'work', h: r('work', lang) }, { k: 'pricing', h: r('pricing', lang) }, { k: 'about', h: r('about', lang) }, { k: 'game', h: r('game', lang) }, { k: 'contact', h: r('contact', lang) },
] as const;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site + path} />
  <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={site + other} />
  <link rel="alternate" hreflang={lang} href={site + path} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site + image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="google-site-verification" content="FtAuPADJK2NBeqQlpfsNBLrkuEiJv9SCDy-PySNsQQA" />
  <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  {intro && <link rel="preload" href="/fonts/press-start-2p.woff2" as="font" type="font/woff2" crossorigin />}
  {intro && <script is:inline>
    /* Entry animation (home only): once per browser session, skipped for reduced motion. */
    (function(){try{var force=/[?&]intro(=|&|$)/.test(location.search);if(!force&&sessionStorage.getItem('kr-intro'))return;sessionStorage.setItem('kr-intro','1');document.documentElement.classList.add('warp')}catch(e){}})();
  </script>}
  <script is:inline>
    /* always start at the top after a reload (unless the URL targets a section) */
    (function(){try{if('scrollRestoration' in history)history.scrollRestoration='manual';if(!location.hash){window.scrollTo(0,0);addEventListener('load',function(){window.scrollTo(0,0)})}}catch(e){}})();
    (function(){try{var t=localStorage.getItem('kr-theme');document.documentElement.setAttribute('data-theme',(t==='dark'||t==='light')?t:'dark');if(localStorage.getItem('kr-sound')==='off')document.documentElement.classList.add('muted')}catch(e){}})();
  </script>
</head>
<body>
  {intro && (
  <div id="warp" aria-hidden="true"><canvas></canvas>
    <div class="wsc">
      <p class="wq" data-t={lang === 'fr' ? 'On veut décider avec la donnée ?' : 'Want to decide with data?'}></p>
      <p class="wq2" data-t={lang === 'fr' ? '> Oui. On range tout ça.' : '> Yes. Let’s tidy this up.'}></p>
      <div class="wdev"><div class="wscr">
        <div class="wmess">
          <div class="wt" style="--r:-5deg"><small>CA ???</small><b class="bad">#N/A</b></div>
          <div class="wt" style="--r:4deg"><small>CLIENTS</small><b>12O</b></div>
          <div class="wt" style="--r:-2deg"><small>MARGE</small><b class="bad">ERR!</b></div>
          <div class="wbars" style="--r:3deg"><i style="height:30%"></i><i style="height:85%"></i><i style="height:12%"></i><i class="bad" style="height:60%"></i><i style="height:44%"></i><i style="height:95%"></i></div>
          <div class="wnote" style="--r:-7deg">v3_FINAL(2).xlsx</div>
        </div>
        <div class="wclean">
          <div class="wc-h"><b>{lang === 'fr' ? 'Tableau de bord' : 'Dashboard'}</b><span>● live</span></div>
          <div class="wc-k"><div><small>{lang === 'fr' ? 'CA du mois' : 'Revenue'}</small><b>48,2 k€</b><em>▲ 12 %</em></div><div><small>Clients</small><b>128</b><em>▲ 9</em></div><div><small>{lang === 'fr' ? 'Marge' : 'Margin'}</small><b>31 %</b><em>▲ 2 pts</em></div></div>
          <div class="wc-c"><svg viewBox="0 0 200 70" preserveAspectRatio="none"><polyline fill="none" stroke="#0E5257" stroke-width="3" stroke-linejoin="round" points="0,58 25,52 50,55 75,42 100,44 125,32 150,26 175,18 200,10"/><polyline fill="none" stroke="#9FD3CC" stroke-width="1.5" stroke-dasharray="4 4" points="0,46 200,46"/></svg><svg viewBox="0 0 42 42" class="wc-d"><circle cx="21" cy="21" r="15.9" fill="none" stroke="#E8E1D3" stroke-width="6"/><circle cx="21" cy="21" r="15.9" fill="none" stroke="#0E5257" stroke-width="6" stroke-dasharray="64 36" transform="rotate(-90 21 21)"/><circle cx="21" cy="21" r="15.9" fill="none" stroke="#2A8C8C" stroke-width="6" stroke-dasharray="22 78" stroke-dashoffset="-64" transform="rotate(-90 21 21)"/></svg></div>
        </div>
      </div></div>
      <svg class="wpad" viewBox="0 0 240 160" aria-hidden="true">
        <defs><filter id="pdpx" filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse" x="0" y="0" width="240" height="160"><feFlood x="2" y="2" width="1" height="1"/><feComposite width="4" height="4"/><feTile result="t"/><feComposite in="SourceGraphic" in2="t" operator="in"/><feMorphology operator="dilate" radius="2"/></filter><linearGradient id="pdb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2E353D"/><stop offset="1" stop-color="#171B20"/></linearGradient></defs>
        <g filter="url(#pdpx)"><path d="M58 22 C40 22 30 30 24 46 C14 72 6 104 10 128 C13 146 30 152 42 142 C54 132 62 116 74 108 C90 100 150 100 166 108 C178 116 186 132 198 142 C210 152 227 146 230 128 C234 104 226 72 216 46 C210 30 200 22 182 22 C164 22 152 30 120 30 C88 30 76 22 58 22 Z" fill="url(#pdb)" stroke="#0B0D10" stroke-width="3"/>
        <path d="M52 30 C70 28 84 36 120 36 C156 36 170 28 188 30" fill="none" stroke="#4A535D" stroke-width="2" stroke-linecap="round" opacity=".7"/>
        <circle cx="120" cy="52" r="11" fill="#0B0D10"/><circle cx="120" cy="52" r="8" fill="#1AA7B0"/><text x="120" y="55.5" text-anchor="middle" font-size="8" font-weight="800" fill="#0B2A2C" font-family="Archivo,sans-serif">KR</text>
        <rect x="100" y="66" width="9" height="5" rx="2.5" fill="#4A535D"/><rect x="131" y="66" width="9" height="5" rx="2.5" fill="#4A535D"/>
        <circle cx="62" cy="58" r="15" fill="#0B0D10"/><circle cx="62" cy="58" r="11" fill="#3A424C"/><circle cx="62" cy="58" r="7" fill="#2A3038"/>
        <g fill="#0B0D10"><rect x="84" y="90" width="10" height="28" rx="2"/><rect x="75" y="99" width="28" height="10" rx="2"/></g><g fill="#3A424C"><rect x="86" y="92" width="6" height="24" rx="1"/><rect x="77" y="101" width="24" height="6" rx="1"/></g>
        <circle cx="148" cy="104" r="15" fill="#0B0D10"/><circle cx="148" cy="104" r="11" fill="#3A424C"/><circle cx="148" cy="104" r="7" fill="#2A3038"/>
        <g font-family="Archivo,sans-serif" font-weight="800" font-size="9" text-anchor="middle">
          <circle cx="180" cy="42" r="8.5" fill="#E8B923"/>
          <circle cx="166" cy="56" r="8.5" fill="#2F7FE0"/>
          <circle cx="194" cy="56" r="8.5" fill="#E0443A"/>
          <circle class="wring" cx="180" cy="70" r="12" fill="none" stroke="#9FE0D8" stroke-width="3"/>
          <g class="wa"><circle cx="180" cy="70" r="9.5" fill="#3DBE5A" stroke="#0B0D10" stroke-width="1.5"/></g>
        </g>
      </g><g text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="7"><text x="180.5" y="46" fill="#3A2A00">Y</text><text x="166.5" y="60" fill="#fff">X</text><text x="194.5" y="60" fill="#fff">B</text><g class="wa"><text x="180.5" y="74" fill="#0B2A0F">A</text></g></g></svg>
    </div>
    <p class="wask">{lang === 'fr' ? 'Appuyez sur A pour décoller' : 'Press A to take off'} <kbd>A</kbd><small>{lang === 'fr' ? 'ou Espace, Entrée, clic gauche ou clic droit' : 'or Space, Enter, left or right click'}</small></p>
    <button class="wskip" type="button">{lang === 'fr' ? 'Passer' : 'Skip'} ›</button>
    <div class="wl"><span>KR<i>.csv</i></span></div></div>
  )}
  {!bare && (
  <header class="nav" id="nav">
    <div class="in">
      <div class="bar">
      <a class="logo" href={r('home', lang)} aria-label="Kevin Radja">KR<i>.csv</i></a>
      <nav class="links">
        {nav.map(n => <a class:list={['l', { on: path.startsWith(n.h) && n.h !== '/' }]} href={n.h}>{ui.nav[n.k][lang]}</a>)}
      </nav>
      <div class="tools">
      <a class="ic" href={other} title={lang === 'fr' ? 'English version' : 'Version française'}>{lang === 'fr' ? 'EN' : 'FR'}</a>
      <button class="ic" id="theme" aria-label={ui.theme[lang]} title={ui.theme[lang]}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="ic" id="sound" data-silent aria-label={ui.sound[lang]} title={ui.sound[lang]}>
        <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>
        <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
      </button>
      <a class="li" href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        <span>LinkedIn</span>
      </a>
      </div>
      <button class="ic burger" id="burger" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      </div>
      <a class="btn p sm cta" href={calendly} target="_blank" rel="noopener">{ui.nav.cta[lang]}</a>
    </div>
  </header>
  )}
  <main><slot /></main>
  {!bare && (
  <footer class="foot">
    <div class="wrap in">
      <div class="foot-tag">{lang === 'fr' ? 'Vos données, enfin lisibles.' : 'Your data, finally readable.'}</div>
      <div class="links">
        <a href={r('work', lang)}>{ui.nav.work[lang]}</a><a href={r('pricing', lang)}>{ui.nav.pricing[lang]}</a><a href={r('about', lang)}>{ui.nav.about[lang]}</a><a href={r('game', lang)}>{ui.nav.game[lang]}</a><a href={r('contact', lang)}>{ui.nav.contact[lang]}</a>
      </div>
      <div class="links">
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={links.malt} target="_blank" rel="noopener">Malt</a>
        <a href={r('legal', lang)}>{ui.footer.legal[lang]}</a><a href={r('privacy', lang)}>{ui.footer.privacy[lang]}</a>
      </div>
    </div>
    <div class="foot-giant-box"><span class="foot-giant" aria-hidden="true">Kevin Radja</span></div>
    <div class="wrap">
      <div class="foot-bot"><span>{ui.footer.siret[lang]}</span><span>© {new Date().getFullYear()} Kevin Radja · {ui.footer.line[lang]}</span></div>
    </div>
  </footer>
  )}
  {intro && <script is:inline>
    (function(){
      var root=document.documentElement,w=document.getElementById('warp');if(!w)return;
      if(!root.classList.contains('warp')){w.remove();return}
      var c=w.querySelector('canvas'),x=c.getContext('2d'),W,H,dpr=Math.min(2,window.devicePixelRatio||1),S=[],t0=performance.now(),done=false;
      function rs(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0)}rs();addEventListener('resize',rs);
      function star(z){return{x:(Math.random()-.5)*2,y:(Math.random()-.5)*2,z:z||Math.random()*1+.05,c:Math.random()<.3?'#9FE0D8':'#F4EFE4'}}
      for(var i=0;i<900;i++)S.push(star());
      var PRE=3100,WARP=2000,SPLASH=750,rm=root.classList.contains('warp-rm');
      var q0=w.querySelector('.wq');
      /* the question types only after the press, so the keyboard sound is allowed */
      function typeQ(cb){if(!q0){cb();return}var full=q0.dataset.t,ci=0,ti=setInterval(function(){ci++;q0.textContent=full.slice(0,ci);if(full[ci-1]!==' '&&loud)key();if(ci>=full.length){clearInterval(ti);setTimeout(cb,250)}},45)}
      var launchAt=null,loud=false,plouf=false;
      function key(){try{window.KR&&KR.sfx&&KR.sfx.play('key')}catch(e){}}
      function answer(cb){var a=w.querySelector('.wq2');if(!a){cb();return}var txt=a.dataset.t,i=0;setTimeout(function(){var iv=setInterval(function(){i++;a.textContent=txt.slice(0,i);if(txt[i-1]!==' '&&loud)key();if(i>=txt.length){clearInterval(iv);cb()}},55)},350)}
      function snd(n){try{if(loud&&window.KR&&KR.sfx)KR.sfx.playSoon(n)}catch(e){}}
      var going=false;
      function go(user){if(launchAt||going)return;going=true;loud=!!user;w.classList.add('press');snd('padA');
        setTimeout(function(){typeQ(function(){w.classList.add('fix');snd('heal');
          /* everything written, then a one-second pause before take-off */
          answer(function(){setTimeout(function(){w.classList.add('launch');launchAt=performance.now();snd('warp');setTimeout(end,WARP+SPLASH+1500)},1000)})})},300)}
      setTimeout(function(){if(!going)w.classList.add('ask')},900);
      function end(){if(done)return;done=true;root.classList.remove('warp');root.classList.add('warp-in');w.remove();setTimeout(function(){root.classList.remove('warp-in')},800)}
      function late(){if(!going)go(true);else loud=true}
      w.addEventListener('click',late);
      addEventListener('keydown',function(e){if(done)return;var k=(e.key||'').toLowerCase();if(k==='a'||k===' '||k==='enter'){e.preventDefault();late()}});
      w.addEventListener('contextmenu',function(e){e.preventDefault();late()});
      /* the wheel cannot unlock sound: it only makes the invitation flash, the visitor must click or press a key */
      var nT=0;function nudge(){if(done||going)return;w.classList.add('ask');w.classList.remove('nudge');void w.offsetWidth;w.classList.add('nudge');clearTimeout(nT);nT=setTimeout(function(){w.classList.remove('nudge')},900)}
      addEventListener('wheel',nudge,{passive:true});addEventListener('touchmove',nudge,{passive:true});
      var sk=w.querySelector('.wskip');if(sk)sk.addEventListener('click',function(e){e.stopPropagation();end()});
      function f(now){if(done)return;if(!launchAt){requestAnimationFrame(f);return}var t=now-launchAt;if(rm)t=Math.max(t,WARP);var p=Math.min(1,t/WARP),sp=.003+Math.pow(p,2.4)*.075;
        x.fillStyle='rgba(7,28,30,'+(p<.9?.35:.6)+')';x.fillRect(0,0,W,H);
        var cx=W/2,cy=H/2,k=Math.max(W,H)*.5;
        for(var i=0;i<S.length;i++){var s=S[i],px=cx+s.x/s.z*k,py=cy+s.y/s.z*k;s.z-=sp;if(s.z<=.02){S[i]=star(1);continue}
          var nx=cx+s.x/s.z*k,ny=cy+s.y/s.z*k;x.strokeStyle=s.c;x.globalAlpha=Math.min(1,(1-s.z)*1.4);x.lineWidth=Math.min(3,(1-s.z)*2.6);x.beginPath();x.moveTo(px,py);x.lineTo(nx,ny);x.stroke()}
        x.globalAlpha=1;
        if(t>WARP){if(!plouf){plouf=true;snd('plouf')}var q=Math.min(1,(t-WARP)/SPLASH),e=1-Math.pow(1-q,3),R=e*Math.hypot(W,H)*.6;
          w.style.webkitMaskImage=w.style.maskImage='radial-gradient(circle at 50% 50%, transparent '+R+'px, #000 '+(R+2)+'px)';
          for(var j=0;j<3;j++){var r2=R*(1+j*.18)+4;x.strokeStyle='rgba(159,224,216,'+(1-q)*(.9-j*.25)+')';x.lineWidth=6-j*2;x.beginPath();x.arc(cx,cy,r2,0,7);x.stroke()}
          if(q>=1)return end()}
        requestAnimationFrame(f)}
      requestAnimationFrame(f);
    })();
  </script>}
  <script is:inline src="/sfx.js"></script>
  <script is:inline>
    (function(){
      var root=document.documentElement;
      function cur(){return root.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}
      function paint(){
        document.querySelectorAll('iframe').forEach(function(f){try{f.contentWindow.postMessage({krTheme:cur()},'*')}catch(e){}})}
      var b=document.getElementById('theme');if(b)b.onclick=function(){var n=cur()==='dark'?'light':'dark';root.setAttribute('data-theme',n);try{localStorage.setItem('kr-theme',n)}catch(e){}paint()};
      paint();
      var sb=document.getElementById('sound');function ps(){var m=window.KR&&KR.sfx&&KR.sfx.isMuted();root.classList.toggle('muted',!!m);
        document.querySelectorAll('iframe').forEach(function(f){try{f.contentWindow.postMessage({krSound:m?'off':'on'},'*')}catch(e){}})}
      if(sb)sb.onclick=function(){if(!window.KR||!KR.sfx)return;var m=!KR.sfx.isMuted();KR.sfx.mute(m);if(!m)KR.sfx.play('toggle');ps()};ps();
      var bg=document.getElementById('burger'),nv=document.getElementById('nav');if(bg)bg.onclick=function(){nv.classList.toggle('open')};
      var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.1});
      document.querySelectorAll('.rv').forEach(function(e){io.observe(e)});
      /* Apple-like motion: word reveal on big titles, zoom-in visuals, expanding petrol bands, counters, 3D tilt */
      (function(){
        var sel='.pg-title,.c-head h2,.head h2,.c-final-t,.c-band-t,.pj-next-t,.c-reveal-no';
        document.querySelectorAll(sel).forEach(function(h){if(h.dataset.split)return;h.dataset.split=1;var n=0;
          [].slice.call(h.childNodes).forEach(function(c){if(c.nodeType!==3)return;var f=document.createDocumentFragment();
            c.textContent.split(/(\s+)/).forEach(function(w){if(!w)return;if(/^\s+$/.test(w)){f.appendChild(document.createTextNode(' '));return}
              var o=document.createElement('span');o.className='w';var i=document.createElement('span');i.textContent=w;i.style.setProperty('--i',n++);o.appendChild(i);f.appendChild(o)});
            h.replaceChild(f,c)});h.classList.add('split')});
        var io2=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io2.unobserve(x.target)}})},{threshold:.2});
        document.querySelectorAll('.split,.c-band,.pj-next,.c-mission,[data-count]').forEach(function(e){io2.observe(e)});
        var zs=[].slice.call(document.querySelectorAll('[data-zoom],.c-band,.pj-next,.c-mission'));
        function z(){var vh=innerHeight;zs.forEach(function(e){var r=e.getBoundingClientRect(),p=Math.min(1,Math.max(0,(vh-r.top)/(vh*.85)));e.style.setProperty('--z',p.toFixed(3))})}
        if(zs.length){addEventListener('scroll',z,{passive:true});addEventListener('resize',z);z()}
        document.querySelectorAll('.c-hero-l b,.stats b').forEach(function(b){var m=b.textContent.match(/^(\d(?:[\d\u00a0\u202f ]*\d)?)(.*)$/);if(!m)return;var to=parseInt(m[1].replace(/\D/g,''),10);if(!to)return;
          b.dataset.count=1;b._to=to;b._suf=m[2];b._fmt=/\s|\u00a0|\u202f/.test(m[1].trim());io2.observe(b)});
        var cio=new IntersectionObserver(function(es){es.forEach(function(x){if(!x.isIntersecting)return;cio.unobserve(x.target);var b=x.target,t0=performance.now(),d=1400;
          (function st(t){var p=Math.min(1,(t-t0)/d),v=Math.round(b._to*(1-Math.pow(1-p,3)));b.textContent=(b._fmt?v.toLocaleString('fr-FR'):v)+b._suf;if(p<1)requestAnimationFrame(st)})(t0)})},{threshold:.6});
        document.querySelectorAll('[data-count]').forEach(function(b){if(b._to)cio.observe(b)});
        if(matchMedia('(hover:hover)').matches)document.querySelectorAll('.pc').forEach(function(c){
          c.addEventListener('mousemove',function(e){var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform='perspective(900px) rotateY('+(x*8)+'deg) rotateX('+(-y*8)+'deg) translateY(-4px)'});
          c.addEventListener('mouseleave',function(){c.style.transform=''})});
        /* the avatar thinks, winks while dealing, then smiles */
        window.krDeal=function(d){var im=d.querySelector('.deal-av img'),bb=d.querySelector('.deal-bubble');if(!im)return;
          setTimeout(function(){im.src='/avatar-px-wink.svg';if(bb)bb.textContent=bb.dataset.b;d.classList.add('in');if(window.KR&&KR.sfx)KR.sfx.play('stage1')},900);
          setTimeout(function(){im.src='/avatar-px.svg';if(bb)bb.textContent=bb.dataset.c},2300)};
        ['/avatar-px-wink.svg','/avatar-px.svg'].forEach(function(u){var i=new Image();i.src=u});
        var dl=document.querySelector('.deal:not(.in)');if(dl&&!document.querySelector('.c-hero')){var dio=new IntersectionObserver(function(es){if(es[0].isIntersecting){dl.classList.add('go');krDeal(dl);dio.disconnect()}},{threshold:.2});dio.observe(dl)}
      })();
      /* fit giant one-line words to their container so nothing overflows */
      (function(){var els=[].slice.call(document.querySelectorAll('.c-giant,.foot-giant,.c-big,.pj-next-t'));if(!els.length)return;
        function fit(){els.forEach(function(e){e.style.fontSize='';var par=e.parentElement,cs=getComputedStyle(par),w=par.clientWidth-parseFloat(cs.paddingLeft)-parseFloat(cs.paddingRight);
          var nw=getComputedStyle(e).whiteSpace==='nowrap';if(!nw)return;var sw=e.scrollWidth;if(sw>w&&w>0){var f=parseFloat(getComputedStyle(e).fontSize);e.style.fontSize=Math.floor(f*w/sw*0.97)+'px'}})}
        var t;addEventListener('resize',function(){clearTimeout(t);t=setTimeout(fit,120)});
        if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);addEventListener('load',fit);fit();
        document.querySelectorAll('.c-slider button').forEach(function(b){b.addEventListener('click',function(){setTimeout(fit,30)})});setInterval(function(){if(document.querySelector('.c-slide-txt.on'))fit()},6100)})();
      window.addEventListener('message',function(e){if(e.data&&e.data.krHeight){document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=Math.ceil(e.data.krHeight)+'px'})}});
    })();
  </script>
  <div class="sbar" aria-hidden="true"><span class="sbar-l">{lang === 'fr' ? 'Défiler' : 'Scroll'}<i>↓</i></span><span class="sbar-t"><b></b></span></div>
  <script is:inline>
    (function(){var b=document.querySelector('.sbar');if(!b)return;var t=b.querySelector('.sbar-t'),de=document.documentElement;
      function upd(){var max=de.scrollHeight-innerHeight,p=max>0?Math.min(1,Math.max(0,scrollY/max)):0;b.style.setProperty('--sp',p.toFixed(4));b.classList.toggle('none',max<40);b.classList.toggle('moved',scrollY>60)}
      addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);addEventListener('load',upd);upd();setTimeout(upd,800);
      /* drag the rail (or click anywhere on it) to move through the page */
      var drag=false;function go(e,smooth){var r=t.getBoundingClientRect(),p=Math.min(1,Math.max(0,(e.clientY-r.top)/r.height));scrollTo({top:p*(de.scrollHeight-innerHeight),behavior:smooth?'smooth':'auto'})}
      t.addEventListener('pointerdown',function(e){e.preventDefault();drag=true;b.classList.add('drag');try{t.setPointerCapture(e.pointerId)}catch(_){}go(e,false)});
      t.addEventListener('pointermove',function(e){if(drag)go(e,false)});
      ['pointerup','pointercancel','lostpointercapture'].forEach(function(n){t.addEventListener(n,function(){drag=false;b.classList.remove('drag')})})})();
  </script>
</body>
