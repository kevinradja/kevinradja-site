---
import type { Lang, Project } from '../data/projects';
import { projects } from '../data/projects';
import { ui, project as url, r } from '../i18n';
import Dashboard from './Dashboard.astro';
const { p, lang } = Astro.props as { p: Project; lang: Lang };
const i = projects.indexOf(p);
const next = projects[(i + 1) % projects.length];
const C = ui.common;
---
<section class="pj-hero">
  <div class="wrap">
    <a class="btn s sm vitrine-back" href={r('portfolio', lang)} style="display:none;margin-bottom:22px">{C.back[lang]}</a>
    <div class="kicker">{C.caseStudy[lang]} · {p.client[lang]} · {p.year}</div>
    <h1 class="pg-title">{p.title[lang]}</h1>
    <p class="lead">{p.intro[lang]}</p>
    <div class="meta">{p.tags[lang].map(t => <span class="chip">{t}</span>)}<span class="chip a">{p.sector[lang]}</span></div>
    <div class="device pj-dev" data-zoom><div class="scr"><img src={p.thumb} alt={p.title[lang]} width="1920" height="1080" /></div></div>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <div class="pj-four">
      <div><span>01</span><h3>{C.mission[lang]}</h3><p>{p.mission[lang]}</p></div>
      <div><span>02</span><h3>{C.challenge[lang]}</h3><p>{p.challenge[lang]}</p></div>
      <div><span>03</span><h3>{C.solution[lang]}</h3><p>{p.solution[lang]}</p></div>
      <div class="hl"><span>04</span><h3>{C.result[lang]}</h3><p>{p.result[lang]}</p></div>
    </div>
    <div class="prose pj-prose">{p.body[lang].map(b => <p>{b}</p>)}</div>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <div class="c-head"><div class="kicker">Dashboard</div><h2>{lang === 'fr' ? 'Testez-le vous-même.' : 'Try it yourself.'}</h2></div>
    <Dashboard id={p.dash} lang={lang} title={lang === 'fr' ? 'Testez le dashboard' : 'Try the dashboard'} />
  </div>
</section>
<section class="pj-next">
  <div class="wrap">
    <a class="pj-next-in" href={url(next.slug, lang)} data-next>
      <span class="kicker">{C.next[lang]}</span>
      <span class="pj-next-t">{next.title[lang]}</span>
      <span class="btn p">{lang === 'fr' ? 'Voir le projet' : 'See the project'} →</span>
    </a>
    <div style="text-align:center;margin-top:22px"><a class="btn s" href={r('work', lang)}>← {C.allProjects[lang]}</a></div>
  </div>
</section>
<script is:inline>
  /* vitrine mode (?v=1): hide nav, footer and contact links; keep the marker on internal project links */
  (function(){if(!/[?&]v=1(&|$)/.test(location.search))return;document.documentElement.classList.add('vitrine');
    var s=document.createElement('style');s.textContent='.vitrine .nav,.vitrine .foot,.vitrine .cta{display:none!important}.vitrine .vitrine-back{display:inline-flex!important}';document.head.appendChild(s);
    var fr=document.documentElement.lang==='fr',list=fr?'/realisations/':'/en/work/',port=fr?'/portfolio/':'/en/portfolio/';
    document.querySelectorAll('a[href]').forEach(function(a){var h=a.getAttribute('href');if(h===list){a.setAttribute('href',port);return}if(h.indexOf(list)===0&&h.indexOf('v=1')<0)a.setAttribute('href',h+(h.indexOf('?')<0?'?':'&')+'v=1')});
  })();
</script>
