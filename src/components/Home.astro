<script is:inline>
  (function(){
    // story: the device changes state while the section is pinned
    var sec=document.getElementById('story');
    if(sec){var st=sec.querySelector('.stage'),li=sec.querySelectorAll('.c-steps li'),cap=sec.querySelector('.cap'),ex=sec.querySelectorAll('.c-explain p');
      var caps=['ventes_mars_FINAL_v3(2).xlsx','ventes_mars_propre.csv','ca_mensuel.pbix','dashboard · live'];
      var upd=function(){var r=sec.getBoundingClientRect(),h=sec.offsetHeight-innerHeight,p=h>0?Math.min(1,Math.max(0,-r.top/h)):1,k=Math.min(3,Math.floor(p*4.2));
        st.style.setProperty('--p',p.toFixed(3));if(st.dataset.step!=String(k)){var dv=st.closest('.device');if(st.dataset.step!==undefined&&dv){dv.classList.remove('shake');void dv.offsetWidth;dv.classList.add('shake');clearTimeout(dv._t);dv._t=setTimeout(function(){dv.classList.remove('shake')},700)}var pv=st.dataset.step===undefined?-1:+st.dataset.step;if(pv>=0&&window.KR&&KR.sfx)KR.sfx.play(k>pv?(k===3?'stage3':'heal'):(k===0?'hurt':'ouch'));if(pv>=0&&k<pv&&dv){var e2=document.createElement('span');e2.className='heal hurt';e2.innerHTML='−1 <i>♥</i>';e2.style.left='46%';dv.appendChild(e2);setTimeout(function(){e2.remove()},1400)}if(pv>=0&&k>pv&&dv){for(var h=0;h<3;h++){(function(h){var e=document.createElement('span');e.className='heal';e.innerHTML=h===0?'+1 <i>♥</i>':'<i>♥</i>';e.style.left=(42+h*9-(h?14:0))+'%';e.style.animationDelay=(h*.12)+'s';dv.appendChild(e);setTimeout(function(){e.remove()},1500)})(h)}}st.dataset.step=k;cap.textContent=caps[k];if(dv){var hv=[25,55,80,100][k];dv.style.setProperty('--hp',hv+'%');dv.dataset.hp=k;dv.querySelectorAll('.hp .h').forEach(function(e,j){e.classList.toggle('on',j<[1,3,4,5][k])})}li.forEach(function(e,i){e.classList.toggle('on',i===k)});ex.forEach(function(e,i){e.classList.toggle('on',i===k)})}};
      addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd()}
    // hero: title zooms and fades, device comes forward while scrolling
    var ht=document.querySelector('.c-title'),hd=document.querySelector('.c-hero-dev');
    if(ht&&hd){var hz=function(){var p=Math.min(1,Math.max(0,scrollY/(innerHeight*.8)));ht.style.transform='scale('+(1+p*.35)+')';ht.style.opacity=String(1-p*.85);hd.style.setProperty('--hp',p.toFixed(3))};addEventListener('scroll',hz,{passive:true});hz()}
    // dashboard tabs inside the story device
    document.querySelectorAll('.db').forEach(function(d){var bs=d.querySelectorAll('.db-tabs button'),ps=d.querySelectorAll('.db-p');
      bs.forEach(function(b){b.addEventListener('click',function(){bs.forEach(function(x){x.classList.toggle('on',x===b)});ps.forEach(function(q){q.classList.toggle('on',q.dataset.t===b.dataset.t)})})})});
    // work carousel: auto-scroll, drag with the mouse, swipe or trackpad
    var mq=document.querySelector('.c-marquee'),tk=mq&&mq.querySelector('.c-track');
    if(mq&&tk){var x=0,half=0,drag=false,sx=0,ox=0,moved=0,hover=false,idle=0;
      var wt=0,cs=function(){return window.KR&&KR.sfx&&KR.sfx.cloud},whoosh=function(dx){var C=cs();if(!C)return;C.start();var pos=half?((-x)%half)/half:0;C.set(Math.max(.75,Math.min(1.5,(dx>0?1.12:.9)*(.9+pos*.3)+Math.min(.2,Math.abs(dx)/120))));clearTimeout(wt);if(!drag)wt=setTimeout(function(){C.stop()},220)};
      var meas=function(){half=tk.scrollWidth/2};meas();addEventListener('resize',meas);addEventListener('load',meas);
      var wrap=function(){if(!half)return;while(x<=-half)x+=half;while(x>0)x-=half};
      var last=performance.now();(function f(t){var dt=t-last;last=t;if(!drag&&!hover&&t>idle)x-=dt*.045;wrap();tk.style.transform='translate3d('+x+'px,0,0)';requestAnimationFrame(f)})(last);
      mq.addEventListener('mouseenter',function(){hover=true});mq.addEventListener('mouseleave',function(){hover=false;drag=false;mq.classList.remove('drag');var C=cs();if(C)C.stop()});addEventListener('pointercancel',function(){drag=false;var C=cs();if(C)C.stop()});addEventListener('blur',function(){var C=cs();if(C)C.stop()});
      mq.addEventListener('pointerdown',function(e){drag=true;sx=e.clientX;ox=x;moved=0});
      addEventListener('pointermove',function(e){if(!drag)return;var d=e.clientX-sx;moved=Math.max(moved,Math.abs(d));if(moved>5)mq.classList.add('drag');var dx=e.clientX-(mq._lx||e.clientX);mq._lx=e.clientX;x=ox+d;whoosh(dx)});
      addEventListener('pointerup',function(){if(!drag)return;drag=false;var C=cs();if(C)C.stop();idle=performance.now()+1500;setTimeout(function(){mq.classList.remove('drag')},0)});
      mq.addEventListener('click',function(e){if(moved>5){e.preventDefault();e.stopPropagation()}},true);
      mq.addEventListener('wheel',function(e){if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){e.preventDefault();x-=e.deltaX;whoosh(-e.deltaX);idle=performance.now()+1500}},{passive:false})}
    // pricing: deal the cards when the section shows up
    var dl=document.getElementById('deal');
    if(dl){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){dl.classList.add('go');if(window.krDeal)krDeal(dl);else dl.classList.add('in');io.disconnect()}})},{threshold:.25});io.observe(dl)}
    // game band: a looping chat between Kevin and the villagers
    document.querySelectorAll('.c-talk[data-lines]').forEach(function(box){var L=JSON.parse(box.dataset.lines),i=0;
      function add(){var l=L[i%L.length],me=l[0].indexOf('avatar')>=0,d=document.createElement('div');d.className='tk'+(me?' me':'');
        d.innerHTML=me?'<span></span><img alt="" src="'+l[0]+'">':'<img alt="" src="'+l[0]+'"><span></span>';d.querySelector('span').textContent=l[1];
        box.appendChild(d);requestAnimationFrame(function(){d.classList.add('in')});while(box.children.length>3){var o=box.firstElementChild;o.remove()}i++}
      add();add();setInterval(add,2200)});
    // results slider
    document.querySelectorAll('.c-slider').forEach(function(s){var n=s.querySelectorAll('.c-slide').length,i=0,t;
      function go(k){i=(k+n)%n;['.c-slide','.c-slide-txt','.c-dots button'].forEach(function(q){s.querySelectorAll(q).forEach(function(e,j){e.classList.toggle('on',j===i)})})}
      s.querySelectorAll('.c-dots button').forEach(function(b,j){b.onclick=function(){go(j);stop()}});
      s.querySelector('.prev').onclick=function(){go(i-1);stop()};s.querySelector('.next').onclick=function(){go(i+1);stop()};
      function stop(){clearInterval(t)}t=setInterval(function(){go(i+1)},6000);s.addEventListener('mouseenter',stop)});
    // mission: lines light up one by one
    var m=document.querySelector('.c-reveal');
    if(m){var sp=m.querySelectorAll('span');var rv=function(){sp.forEach(function(e){e.classList.toggle('lit',e.getBoundingClientRect().top<innerHeight*.8)})};addEventListener('scroll',rv,{passive:true});rv()}
    // audiences
    document.querySelectorAll('.c-aud').forEach(function(a){var bs=a.querySelectorAll('.c-aud-l button'),ps=a.querySelectorAll('.c-aud-p');
      bs.forEach(function(b){b.onclick=function(){bs.forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false')});ps.forEach(function(p){p.classList.toggle('on',p.dataset.i===b.dataset.i)})}})});
  })();
</script>
