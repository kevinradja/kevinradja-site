---
import type { Lang } from '../data/projects';
import { projects } from '../data/projects';
import { r, calendly, links } from '../i18n';
import Logos from './Logos.astro';
import ProjectCard from './ProjectCard.astro';
import Pricing from './Pricing.astro';
import ContactCard from './ContactCard.astro';
const { lang, vitrine = false } = Astro.props as { lang: Lang; vitrine?: boolean };
const T = (fr: string, en: string) => (lang === 'fr' ? fr : en);

const audiences = [
  { w: T('PME', 'SMEs'), img: '', h: T('Des chiffres fiables, sans embaucher.', 'Reliable numbers, without hiring.'), p: T('Sans recruter de data analyst : un prix annoncé d’avance, un livrable que vous gardez, et une équipe formée pour s’en servir.', 'Without hiring a data analyst: an upfront price, a deliverable you keep, and a team trained to use it.'), to: r('pricing', lang), c: T('Voir les offres', 'See the packs') },
  { w: T('Équipes data', 'Data teams'), img: '/thumbs/04.png', h: T('Un renfort qui connaît les grands groupes.', 'Extra hands who know large organisations.'), p: T('Power BI, SQL, Python, clôtures et qualité de données : j’ai livré chez Google, Coface, Dassault Systèmes et KPMG.', 'Power BI, SQL, Python, closes and data quality: delivered at Google, Coface, Dassault Systèmes and KPMG.'), to: r('work', lang), c: T('Voir les réalisations', 'See the work') },
  { w: T('Recruteurs', 'Recruiters'), img: '/avatar.svg', h: T('L’essentiel, en trente secondes.', 'The essentials, in thirty seconds.'), p: T('Parcours, compétences, certifications et disponibilité : tout ce qu’il faut pour décider d’un premier appel.', 'Background, skills, certifications and availability: everything you need to decide on a first call.'), to: r('about', lang), c: T('Voir le parcours', 'See the background') },
];

const results = [
  { v: '−30 %', t: T('de temps de reporting', 'less reporting time'), p: T('Les équipes commerciales passent moins de temps à compiler leurs chiffres, et plus de temps à vendre.', 'Sales teams spend less time compiling numbers, and more time selling.'), c: 'Coface · 12 ' + T('pays', 'countries'), logo: '/logos/coface.svg' },
  { v: '68,7 %', t: T('d’adoption GA4', 'GA4 adoption'), p: T('Les annonceurs ont adopté le nouveau suivi plus vite que prévu : objectifs dépassés dès novembre 2023.', 'Advertisers adopted the new tracking faster than planned: goals beaten by November 2023.'), c: 'Google France', logo: '/logos/google.svg' },
  { v: '100 h → 3 h', t: T('de traitement', 'of processing'), p: T('Ce qui prenait deux semaines de calcul se fait en une matinée, et la direction reçoit ses chiffres à temps.', 'What took two weeks of computing now takes a morning, and leadership gets its numbers on time.'), c: 'Dassault Systèmes', logo: '/logos/dassault.svg' },
  { v: '+35 %', t: T('d’engagement utilisateurs', 'user engagement'), p: T('Un tableau de bord de direction pour suivre l’engagement chaque mois, et des plans d’action lancés directement à partir des chiffres.', 'An executive dashboard to track engagement every month, and action plans launched straight from the numbers.'), c: T('Grand groupe automobile', 'Major automotive group'), logo: '' },
  { v: '−40 %', t: T('de délai de mise en ligne', 'faster time-to-market'), p: T('Les formations sont en ligne plus vite, et RH comme data travaillent enfin sur le même fichier.', 'Training goes live faster, and HR and data finally work from the same file.'), c: T('Grand groupe automobile', 'Major automotive group'), logo: '' },
];
const viz = [
  `<svg viewBox="0 0 200 110"><line x1="0" y1="18" x2="200" y2="18" stroke="var(--line2)" stroke-dasharray="4 5" /><polyline class="draw" fill="none" stroke="var(--acc)" stroke-width="4" stroke-linejoin="round" points="0,18 30,22 60,20 90,38 120,56 150,72 175,80 200,84" /><circle class="fade" cx="200" cy="84" r="6" fill="var(--acc)" /></svg>`,
  `<svg viewBox="0 0 200 110"><path d="M30,100 A70,70 0 0 1 170,100" fill="none" stroke="var(--line)" stroke-width="16" stroke-linecap="round" /><path class="gauge" d="M30,100 A70,70 0 0 1 170,100" fill="none" stroke="var(--acc)" stroke-width="16" stroke-linecap="round" pathLength="400" style="--len:274.8" /></svg>`,
  `<svg viewBox="0 0 200 110"><text x="0" y="30" font-size="13" fill="var(--mute)">100 h</text><rect class="grow" x="44" y="16" width="156" height="20" rx="3" fill="var(--line2)" /><text x="0" y="78" font-size="13" fill="var(--mute)">3 h</text><rect class="grow" x="44" y="64" width="6" height="20" rx="3" fill="var(--acc)" /><text class="fade" x="60" y="79" font-size="14" font-weight="700" fill="var(--acc)">−97 %</text></svg>`,
  `<svg viewBox="0 0 200 110"><rect class="growy" x="12" y="60" width="26" height="34" rx="3" fill="var(--line2)" /><rect class="growy" x="50" y="52" width="26" height="42" rx="3" fill="var(--line2)" /><rect class="growy" x="88" y="40" width="26" height="54" rx="3" fill="var(--acc)" /><rect class="growy" x="126" y="28" width="26" height="66" rx="3" fill="var(--acc)" /><rect class="growy" x="164" y="16" width="26" height="78" rx="3" fill="var(--acc)" /><line x1="0" y1="94" x2="200" y2="94" stroke="var(--line2)" /><text class="fade" x="101" y="34" font-size="10" text-anchor="middle" fill="var(--acc)">${T('PLAN D’ACTION', 'ACTION PLAN')}</text><line class="fade" x1="82" y1="10" x2="82" y2="94" stroke="var(--acc)" stroke-dasharray="3 4" /></svg>`,
  `<svg viewBox="0 0 200 110"><rect class="growy" x="40" y="10" width="46" height="84" rx="3" fill="var(--line2)" /><rect class="growy" x="114" y="44" width="46" height="50" rx="3" fill="var(--acc)" /><line x1="0" y1="94" x2="200" y2="94" stroke="var(--line2)" /><text x="63" y="109" font-size="11" text-anchor="middle" fill="var(--mute)">${T('AVANT', 'BEFORE')}</text><text x="137" y="109" font-size="11" text-anchor="middle" fill="var(--mute)">${T('APRÈS', 'AFTER')}</text></svg>`,
];
const featured = [projects[3], projects[4], projects[5]];
import Testimonials from './Testimonials.astro';
---
<!-- 1. HERO : giant centered title, the "device" rises over it -->
<section class="c-hero">
  <div class="wrap">
    <h1 class="c-title">{T('Vos données,', 'Your data,')}<br />{T('enfin', 'finally')}<br />{T('lisibles.', 'readable.')}</h1>
    <div class="c-hero-row">
      <div class="c-hero-l">
        <div><b>5+</b><span>{T('ans de data & BI', 'years of data & BI')}</span></div>
        <div><b>25 M€+</b><span>{T('de portefeuilles pilotés', 'of portfolios steered')}</span></div>
        <div><b>5 000+</b><span>{T('utilisateurs équipés', 'users equipped')}</span></div>
      </div>
      <div class="device c-hero-dev" aria-hidden="true">
        <div class="scr">
          <div class="dg mini">
            <div class="t"><small>{T('CA du mois', 'Revenue')}</small><b>48,2 k€</b><em>▲ 12 %</em></div>
            <div class="t"><small>Clients</small><b>128</b><em>▲ 9</em></div>
            <div class="t"><small>{T('Panier', 'Basket')}</small><b>376 €</b><em>▲ 4 %</em></div>
            <div class="w"><svg viewBox="0 0 200 60"><polyline fill="none" stroke="var(--acc)" stroke-width="3" points="0,48 25,44 50,46 75,36 100,38 125,28 150,24 175,16 200,10" /></svg></div>
            <div class="d"><svg viewBox="0 0 42 42" width="64" height="64"><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--line)" stroke-width="6" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc)" stroke-width="6" stroke-dasharray="64 36" transform="rotate(-90 21 21)" /></svg></div>
          </div>
        </div>
      </div>
      <div class="c-hero-r">
        <p>{T('Kevin Radja, consultant Data & BI freelance à Paris. Je transforme vos fichiers Excel, SQL et Power BI en tableaux de bord clairs et en reporting automatisé.', 'Kevin Radja, freelance Data & BI consultant in Paris. I turn your Excel, SQL and Power BI files into clear dashboards and automated reporting.')}</p>
        <p class="c-now">{T('En parallèle : Manager Data & Digital dans un grand groupe automobile.', 'Alongside: Data & Digital Manager at a major automotive group.')}</p>
        {!vitrine && <p class="c-avail"><span class="dot"></span>{T('Disponible à temps partiel', 'Available part-time')}</p>}
      </div>
    </div>
    {!vitrine && (
      <div class="c-ctas">
        <a class="btn p" href={calendly} target="_blank" rel="noopener">{T('Réserver un appel', 'Book a call')} →</a>
        <a class="btn s" href={links.linkedin} target="_blank" rel="noopener">LinkedIn →</a>
      </div>
    )}
    <div class="c-logos"><Logos lang={lang} /></div>
  </div>
</section>

<!-- 2. STORY : white panel, giant words, the device morphs while scrolling -->
<section class="c-story" id="story" aria-label={T('Mon métier en quatre étapes', 'What I do, in four steps')}>
  <div class="c-pin">
    <div class="c-panel">
      <div class="kicker">{T('Mon métier', 'What I do')}</div>
      <div class="c-giant">{T('De l’Excel', 'From Excel')}</div>
      <div class="device c-story-dev">
        <div class="hp" aria-hidden="true"><i class="h on"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i></div>
        <div class="scr stage" data-step="0">
          <div class="bar"></div>
          <div class="cap">ventes_mars_FINAL_v3(2).xlsx</div>
          <div class="ly lyT">
            <table class="tb"><thead><tr><th>Client</th><th>Date</th><th>{T('Montant', 'Amount')}</th></tr></thead><tbody>
              <tr><td>Dupont SA</td><td><i class="sw"><span class="o">12/03/24</span><span class="n">12/03/2024</span></i></td><td>1 200 €</td></tr>
              <tr class="dup"><td>DUPONT sa</td><td>2024-03-12</td><td>1200</td></tr>
              <tr><td>Martin &amp; Fils</td><td class="b"><i class="sw"><span class="o">#N/A</span><span class="n">14/03/2024</span></i></td><td>980 €</td></tr>
              <tr><td class="b"><i class="sw"><span class="o">&nbsp;</span><span class="n">Bernard</span></i></td><td><i class="sw"><span class="o">15 mars</span><span class="n">15/03/2024</span></i></td><td class="b"><i class="sw"><span class="o">—</span><span class="n">1 650 €</span></i></td></tr>
              <tr><td>Leroy</td><td><i class="sw"><span class="o">03-18-2024</span><span class="n">18/03/2024</span></i></td><td><i class="sw"><span class="o">2,4k</span><span class="n">2 400 €</span></i></td></tr>
            </tbody></table>
            <span class="note r">{T('5 lignes · 4 problèmes', '5 rows · 4 issues')}</span>
            <span class="note g">✓ {T('0 doublon · 0 cellule vide', '0 duplicates · 0 empty cells')}</span>
          </div>
          <div class="ly ly2">
            <h4>{T('Chiffre d’affaires mensuel', 'Monthly revenue')}</h4>
            <div class="bars"><i style="--h:42%"><span>{T('Janv', 'Jan')}</span></i><i style="--h:55%"><span>{T('Févr', 'Feb')}</span></i><i style="--h:48%"><span>{T('Mars', 'Mar')}</span></i><i style="--h:66%"><span>{T('Avr', 'Apr')}</span></i><i style="--h:74%"><span>{T('Mai', 'May')}</span></i><i style="--h:88%"><span>{T('Juin', 'Jun')}</span></i></div>
          </div>
          <div class="ly ly3">
            <div class="db">
              <div class="db-tabs" role="tablist">
                <button type="button" class="on" data-t="0">{T('Vue d’ensemble', 'Overview')}</button>
                <button type="button" data-t="1">Clients</button>
                <button type="button" data-t="2">{T('Décisions', 'Decisions')}</button>
              </div>
              <div class="db-p on" data-t="0">
                <div class="dg">
                  <div class="t"><small>{T('CA du mois', 'Revenue')}</small><b>48,2 k€</b><em>▲ 12 %</em></div>
                  <div class="t"><small>Clients</small><b>128</b><em>▲ 9</em></div>
                  <div class="t"><small>{T('Panier moyen', 'Avg. basket')}</small><b>376 €</b><em>▲ 4 %</em></div>
                  <div class="w"><svg viewBox="0 0 200 60"><polyline fill="none" stroke="var(--acc)" stroke-width="2.5" points="0,48 25,44 50,46 75,36 100,38 125,28 150,24 175,16 200,10" /><polyline fill="none" stroke="var(--line2)" stroke-width="1.5" stroke-dasharray="4 4" points="0,40 200,40" /></svg></div>
                  <div class="d"><svg viewBox="0 0 42 42" width="70" height="70"><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--line)" stroke-width="6" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc)" stroke-width="6" stroke-dasharray="64 36" transform="rotate(-90 21 21)" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc2)" stroke-width="6" stroke-dasharray="22 78" stroke-dashoffset="-64" transform="rotate(-90 21 21)" /></svg></div>
                </div>
              </div>
              <div class="db-p" data-t="1">
                <ul class="db-bars">
                  <li><span>Leroy</span><i style="--w:92%"></i><b>2 400 €</b></li>
                  <li><span>Bernard</span><i style="--w:64%"></i><b>1 650 €</b></li>
                  <li><span>Dupont SA</span><i style="--w:47%"></i><b>1 200 €</b></li>
                  <li><span>Martin &amp; Fils</span><i style="--w:38%"></i><b>980 €</b></li>
                </ul>
                <p class="db-note">{T('4 clients font 61 % du chiffre du mois.', '4 clients make 61% of this month’s revenue.')}</p>
              </div>
              <div class="db-p" data-t="2">
                <ul class="db-dec">
                  <li><em class="w">!</em>{T('Relancer 14 clients sans commande depuis 60 jours', 'Follow up 14 clients with no order in 60 days')}</li>
                  <li><em class="w">!</em>{T('Marge en baisse sur la gamme B : revoir les prix', 'Margin falling on range B: review prices')}</li>
                  <li><em class="g">✓</em>{T('Stock suffisant pour juin, pas de commande urgente', 'Enough stock for June, no urgent order')}</li>
                </ul>
                <p class="db-cta">{T('Un tableau de bord ne sert à rien s’il ne fait pas décider. Et sur vos chiffres, qu’est-ce qu’il dirait ?', 'A dashboard is useless if it does not drive decisions. What would it say about your numbers?')}{!vitrine && <span> {T('Un audit de 2 h suffit pour le savoir.', 'A 2-hour audit is enough to find out.')}</span>}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="c-giant">{T('au dashboard', 'to dashboard')}</div>
      <ol class="c-steps">
        <li class="on">{T('Collecter', 'Collect')}</li><li>{T('Nettoyer', 'Clean')}</li><li>{T('Visualiser', 'Visualise')}</li><li>{T('Décider', 'Decide')}</li>
      </ol>
      <div class="c-explain">
        <p class="on"><b>01</b>{T('Vos fichiers arrivent comme ils sont : doublons, dates dans tous les formats, cellules vides, #N/A. On rassemble tout au même endroit.', 'Your files arrive as they are: duplicates, dates in every format, empty cells, #N/A. Everything is gathered in one place.')}</p>
        <p><b>02</b>{T('Je nettoie : les lignes se redressent, les doublons disparaissent, chaque date et chaque montant prend le même format.', 'I clean it up: rows straighten, duplicates disappear, every date and amount gets the same format.')}</p>
        <p><b>03</b>{T('Les bons indicateurs, dans le bon graphique, sans fioritures. On voit tout de suite ce qui monte et ce qui baisse.', 'The right metrics, in the right chart, no frills. You instantly see what goes up and what goes down.')}</p>
        <p><b>04</b>{T('Un tableau de bord qui se met à jour tout seul. Vous l’ouvrez le lundi matin et vous décidez.', 'A dashboard that updates itself. You open it on Monday morning and decide.')}</p>
      </div>
    </div>
  </div>
</section>

{!vitrine && (
<section class="c-game" id="jeu">
  <div class="wrap">
    <a class="c-game-in" href={r('game', lang)}>
      <span class="c-cloud c1" aria-hidden="true"></span><span class="c-cloud c2" aria-hidden="true"></span>
      <div class="c-game-art" aria-hidden="true"><span>🏡</span><span>🧑‍💼</span><span>💧</span><span>📒</span></div>
      <div class="c-game-txt">
        <div class="kicker">{T('Une pause ?', 'Need a break?')}</div>
        <h2>{T('Le Village des Données', 'Data Village')}</h2>
        <p>{T('Un RPG en 8-bit : capturez des outils sauvages (Excel, SQL, Power BI…) dans les hautes herbes, aidez les habitants à remettre de l’ordre dans leurs chiffres et complétez votre Datadex. Chaque habitant cache une étape de mon parcours.', 'An 8-bit RPG: catch wild tools (Excel, SQL, Power BI…) in the tall grass, help villagers sort out their numbers and complete your Datadex. Each villager hides a step of my journey.')}</p>
        <span class="btn p">{T('Jouer', 'Play')} →</span>
        <div class="c-talk" aria-hidden="true" data-lines={JSON.stringify([
          ['/npc1.svg', T('Mes registres sont éparpillés partout…', 'My records are scattered everywhere…')],
          ['/avatar-wink.svg', T('Il me faut un Excel. Je vais en capturer un !', 'I need an Excel. I’ll go catch one!')],
          ['/npc2.svg', T('100 heures de calcul à la main, à l’aide !', '100 hours of manual work, help!')],
          ['/avatar.svg', T('Un Python sauvage devrait faire l’affaire.', 'A wild Python should do the trick.')],
          ['/npc3.svg', T('Le puits se vide, personne ne sait pourquoi.', 'The well is emptying, nobody knows why.')],
          ['/avatar-think.svg', T('GA4 et Looker Studio : on va tout mesurer.', 'GA4 and Looker Studio: we’ll measure everything.')],
          ['/npc4-happy.svg', T('Les loyers sont enfin à jour, merci !', 'Rents are finally up to date, thanks!')],
          ['/avatar-wow.svg', T('Datadex 12/19… il manque les légendaires !', 'Datadex 12/19… legendaries still missing!')],
        ])}></div>
      </div>
    </a>
  </div>
</section>
)}

<!-- 3. RESULTS : Caeli-style slider panel -->
<section class="sec c-results" id="resultats">
  <div class="wrap">
    <div class="c-slider rv">
      <div class="c-sl-l">
        <div class="c-dots" role="tablist">{results.map((_, i) => <button type="button" aria-label={String(i + 1)} class:list={[{ on: i === 0 }]} data-i={i}></button>)}</div>
        <div class="kicker">{T('Résultats', 'Results')}</div>
        {results.map((x, i) => (
          <div class:list={['c-slide-txt', { on: i === 0 }]} data-i={i}>
            <div class:list={['c-big', { sm: x.v.length > 7 }]}>{x.v}</div>
            <h3>{x.t}</h3>
            <p>{x.p}</p>
            <span class="c-client">{x.c}</span>
          </div>
        ))}
        <div class="c-arrows"><button type="button" class="prev" aria-label={T('Précédent', 'Previous')}>←</button><button type="button" class="next" aria-label={T('Suivant', 'Next')}>→</button></div>
      </div>
      <div class="c-sl-r">
        {results.map((x, i) => <div class:list={['c-slide', { on: i === 0 }]} data-i={i}><span class="c-logo">{x.logo ? <img src={x.logo} alt={x.c} /> : <b>{x.c}</b>}</span><div class="c-viz" set:html={viz[i]} /></div>)}
      </div>
    </div>
  </div>
</section>

<Testimonials lang={lang} />

<!-- 4. MISSION : full-bleed petrol, words light up while scrolling -->
<section class="c-mission">
  <div class="wrap c-mission-in">
    <div class="c-mission-l">
    <div class="kicker">{T('Ma mission', 'My mission')}</div>
    <h2 class="c-reveal">
      <span>{T('Rendre vos', 'Make your')}</span>
      <span>{T('données', 'data')}</span>
      <span>{T('lisibles, fiables', 'readable, reliable')}</span>
      <span>{T('et utiles.', 'and useful.')}</span>
    </h2>
    <p>{T('Pas de jargon, pas d’usine à gaz : des chiffres justes, que toute l’équipe comprend du premier coup.', 'No jargon, no overbuilt systems: accurate numbers the whole team gets at first glance.')}</p>
    </div>
    {!vitrine && (
    <div class="c-aud c-aud-dark">
    <div class="c-aud-l" role="tablist">
      <div class="kicker">{T('Vous êtes…', 'You are…')}</div>
      {audiences.map((a, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{a.w}</button>)}
    </div>
    <div class="c-aud-r">
      {audiences.map((a, i) => (
        <div class:list={['c-aud-p', { on: i === 0 }]} data-i={i} role="tabpanel">
          {a.img ? <img class:list={[{ avatar: a.img.endsWith('.svg') }]} src={a.img} alt="" loading="lazy" /> : <div class="c-aud-dev"><div class="device"><div class="scr"><div class="dg mini"><div class="t"><small>{T('Trésorerie', 'Cash')}</small><b>62 k€</b><em>▲ 8 %</em></div><div class="t"><small>{T('Marge', 'Margin')}</small><b>31 %</b><em>▲ 2 pts</em></div><div class="t"><small>{T('Factures', 'Invoices')}</small><b>14</b><em>{T('à relancer', 'to chase')}</em></div><div class="w"><svg viewBox="0 0 200 60"><polyline fill="none" stroke="var(--acc)" stroke-width="3" points="0,40 25,42 50,34 75,36 100,26 125,30 150,20 175,18 200,12" /></svg></div><div class="d"><svg viewBox="0 0 42 42" width="64" height="64"><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--line)" stroke-width="6" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc)" stroke-width="6" stroke-dasharray="72 28" transform="rotate(-90 21 21)" /></svg></div></div></div></div></div>}
          <div class="c-aud-card"><h3>{a.h}</h3><p>{a.p}</p><a class="btn p sm" href={a.to}>{a.c} →</a></div>
        </div>
      ))}
    </div>
    </div>
    )}
  </div>
</section>



<!-- 6. WORK : cards slide sideways while scrolling -->
<section class="c-work" id="work">
  <div class="c-work-pin">
    <div class="c-head"><div class="kicker">{T('Réalisations', 'Work')}</div><h2>{T('Des études de cas, avec les dashboards à tester.', 'Case studies, with live dashboards to try.')}</h2></div>
    <p class="c-drag-hint" aria-hidden="true"><svg viewBox="0 0 24 24" class="l"><path d="M15 6l-6 6 6 6"/></svg><span>{T('Glissez pour découvrir', 'Drag to discover')}</span><svg viewBox="0 0 24 24" class="r"><path d="M9 6l6 6-6 6"/></svg></p>
    <div class="c-marquee">
      <div class="c-track">
        {[0, 1].map(k => (vitrine ? projects : projects.slice(3).concat(projects.slice(0, 3))).map(p => <div class="c-slot" aria-hidden={k === 1 ? 'true' : undefined}><ProjectCard p={p} lang={lang} vitrine={vitrine} /></div>))}
      </div>
    </div>
