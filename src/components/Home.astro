---
import type { Lang } from '../data/projects';
import { projects } from '../data/projects';
import { r, calendly, ui, links } from '../i18n';
import Logos from './Logos.astro';
import ProjectCard from './ProjectCard.astro';
import Pricing from './Pricing.astro';
import ContactCard from './ContactCard.astro';
const { lang, vitrine = false } = Astro.props as { lang: Lang; vitrine?: boolean };
const T = (fr: string, en: string) => (lang === 'fr' ? fr : en);
const doors = [
  { e: '🏪', s: T('À la tête d’une PME', 'Running an SME'), k: T('Je dirige une PME', 'I run an SME'), h: T('Des chiffres fiables, sans embaucher.', 'Reliable numbers, without hiring.'), p: T('Un reporting mensuel qui tourne seul, un dashboard que vous ouvrez le lundi matin, un prix annoncé d’avance.', 'A monthly report that runs itself, a dashboard you open on Monday morning, an upfront price.'), to: r('pricing', lang), c: T('Voir les offres', 'See the packs') },
  { e: '📊', s: T('Une équipe data ou finance', 'A data or finance team'), k: T('Je suis une équipe data ou finance', 'I’m a data or finance team'), h: T('Un renfort qui connaît les grands groupes.', 'Extra hands who know large organisations.'), p: T('Power BI, SQL, Python, clôtures et qualité de données : j’ai livré chez Google, Coface, Dassault Systèmes et KPMG.', 'Power BI, SQL, Python, closes and data quality: delivered at Google, Coface, Dassault Systèmes and KPMG.'), to: r('work', lang), c: T('Voir les réalisations', 'See the work') },
  { e: '🤝', s: T('En recherche d’un freelance', 'Hiring a freelancer'), k: T('Je cherche un freelance', 'I’m hiring a freelancer'), h: T('L’essentiel, en trente secondes.', 'The essentials, in thirty seconds.'), p: T('Parcours, outils, façon de travailler et disponibilité : tout ce qu’il faut pour décider d’un premier appel.', 'Background, tools, ways of working and availability: all you need to decide on a first call.'), to: r('about', lang), c: T('Voir le parcours', 'See the background') },
];
const results = [
  { v: '−30 %', l: T('de temps de production du reporting', 'reporting production time'), c: 'Coface · 12 ' + T('pays', 'countries') + ' · 500+ ' + T('utilisateurs', 'users') },
  { v: '68,7 %', l: T('d’adoption GA4 sur 180 grands comptes', 'GA4 adoption across 180 key accounts'), c: 'Google France · ' + T('objectifs dépassés dès nov. 2023', 'goals beaten by Nov. 2023') },
  { v: '100 h → 3 h', l: T('de traitement des données', 'of data processing'), c: 'Dassault Systèmes · ' + T('pipelines Python', 'Python pipelines') },
  { v: '−40 %', l: T('de délai de mise en ligne des formations', 'training time-to-market'), c: T('Groupe automobile · outil partagé RH/data', 'Automotive group · shared HR/data tool') },
];
const viz = [`<svg viewBox="0 0 200 90" preserveAspectRatio="none"><polyline class="draw" fill="none" stroke="var(--acc)" stroke-width="3" stroke-linejoin="round" points="0,14 30,18 60,16 90,30 120,44 150,56 175,62 200,66" /><circle class="fade" cx="200" cy="66" r="5" fill="var(--acc)" /><line x1="0" y1="14" x2="200" y2="14" stroke="var(--line2)" stroke-dasharray="4 5" /></svg>`,`<svg viewBox="0 0 200 100"><path d="M30,92 A70,70 0 0 1 170,92" fill="none" stroke="var(--line)" stroke-width="14" stroke-linecap="round" /><path class="gauge" d="M30,92 A70,70 0 0 1 170,92" fill="none" stroke="var(--acc)" stroke-width="14" stroke-linecap="round" pathLength="400" style="--len:274.8" /></svg>`,`<svg viewBox="0 0 200 90"><text x="0" y="22" font-size="12" fill="var(--mute)">100 h</text><rect class="grow" x="40" y="10" width="160" height="16" rx="2" fill="var(--line2)" /><text x="0" y="62" font-size="12" fill="var(--mute)">3 h</text><rect class="grow" x="40" y="50" width="6" height="16" rx="2" fill="var(--acc)" /><text class="fade" x="54" y="62" font-size="12" font-weight="700" fill="var(--acc)">−97 %</text></svg>`,`<svg viewBox="0 0 200 90"><rect class="growy" x="40" y="10" width="44" height="72" rx="2" fill="var(--line2)" /><rect class="growy" x="116" y="39" width="44" height="43" rx="2" fill="var(--acc)" /><line x1="0" y1="82" x2="200" y2="82" stroke="var(--line2)" /><text x="62" y="96" font-size="11" text-anchor="middle" fill="var(--mute)">AVANT</text><text x="138" y="96" font-size="11" text-anchor="middle" fill="var(--mute)">APRÈS</text></svg>`];
const featured = [projects[3], projects[4], projects[5]];
---
<section class="hero">
  <div class="wrap">
    <div class="kicker">Kevin Radja · {T('Consultant Data & BI freelance', 'Freelance Data & BI consultant')} · Paris</div>
    <h1 class="big">{T('Vos données,', 'Your data,')}<br />{T('enfin', 'finally')} <em>{T('lisibles.', 'readable.')}</em></h1>
    <div class="hero-row">
    <div>
    <p class="lead">{T('Je transforme vos fichiers Excel, SQL et Power BI en tableaux de bord clairs et en reporting automatisé.', 'I turn your Excel, SQL and Power BI files into clear dashboards and automated reporting.')}</p>
    <p class="now"><span class="tag">{T('En parallèle', 'Alongside')}</span><span>{T('Manager Data & Digital dans un grand groupe automobile', 'Data & Digital Manager at a major automotive group')}</span></p>
    {!vitrine && <div class="avail"><span class="dot"></span>{T('Disponible à temps partiel · réponse sous 48 à 72 h', 'Available part-time · reply within 48 to 72 hours')}</div>}
    <div class="row">
      {!vitrine && <a class="btn p" href={calendly} target="_blank" rel="noopener">{T('Réserver un appel de 30 min', 'Book a 30-min call')}</a>}
      {!vitrine && <a class="btn lk" href={links.linkedin} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>{T('Me contacter sur LinkedIn', 'Message me on LinkedIn')}</a>}
      <a class="btn s" href={vitrine ? '#work' : r('work', lang)}>{T('Voir les réalisations', 'See the work')}</a>
    </div>
    </div>
    <div class="stats">
      <div><b>5+</b><span>{T('années d’expérience data & BI', 'years of data & BI experience')}</span></div>
      <div><b>25 M€+</b><span>{T('de portefeuilles pilotés par mes dashboards', 'of portfolios steered by my dashboards')}</span></div>
      <div><b>5 000+</b><span>{T('utilisateurs formés ou équipés', 'users trained or equipped')}</span></div>
    </div>
    </div>
    <Logos lang={lang} />
  </div>
</section>

<section class="story" id="story" aria-label={T('Mon métier en quatre étapes', 'What I do, in four steps')}>
  <div class="wrap story-pin">
    <div>
      <div class="kicker">{T('Mon métier en 4 étapes', 'What I do, in 4 steps')}</div>
      <h2>{T('De l’Excel en vrac au tableau de bord.', 'From messy Excel to dashboard.')}</h2>
      <ol class="st">
        <li class="on"><b>{T('Collecter', 'Collect')}</b><p>{T('Fichiers Excel, exports SQL, outils métier : tout au même endroit.', 'Excel files, SQL exports, business tools: all in one place.')}</p></li>
        <li><b>{T('Nettoyer', 'Clean')}</b><p>{T('Doublons, formats de date, cellules vides : les données deviennent fiables.', 'Duplicates, date formats, empty cells: the data becomes reliable.')}</p></li>
        <li><b>{T('Visualiser', 'Visualise')}</b><p>{T('Les bons indicateurs, dans le bon graphique, sans fioritures.', 'The right metrics, in the right chart, no frills.')}</p></li>
        <li><b>{T('Décider', 'Decide')}</b><p>{T('Un tableau de bord qui se met à jour seul, ouvert chaque lundi matin.', 'A dashboard that updates itself, opened every Monday morning.')}</p></li>
      </ol>
    </div>
    <div class="stage" data-step="0" aria-hidden="true">
      <div class="bar"></div>
      <div class="cap">ventes_mars_FINAL_v3(2).xlsx</div>
      <div class="ly ly0">
        <table class="tb"><thead><tr><th>Client</th><th>Date</th><th>{T('Montant', 'Amount')}</th></tr></thead><tbody>
          <tr><td>Dupont SA</td><td>12/03/24</td><td>1 200 €</td></tr>
          <tr><td class="dup">DUPONT sa</td><td>2024-03-12</td><td>1200</td></tr>
          <tr><td>Martin &amp; Fils</td><td class="bad">#N/A</td><td>980 €</td></tr>
          <tr><td class="bad">&nbsp;</td><td>15 mars</td><td class="bad">—</td></tr>
          <tr><td>Leroy</td><td>03-18-2024</td><td>2,4k</td></tr>
        </tbody></table>
        <span class="note r">{T('5 lignes · 4 problèmes', '5 rows · 4 issues')}</span>
      </div>
      <div class="ly ly1">
        <table class="tb"><thead><tr><th>Client</th><th>Date</th><th>{T('Montant', 'Amount')}</th></tr></thead><tbody>
          <tr><td>Dupont SA</td><td>12/03/2024</td><td>1 200 €</td></tr>
          <tr><td>Martin &amp; Fils</td><td>14/03/2024</td><td>980 €</td></tr>
          <tr><td>Bernard</td><td>15/03/2024</td><td>1 650 €</td></tr>
          <tr><td>Leroy</td><td>18/03/2024</td><td>2 400 €</td></tr>
        </tbody></table>
        <span class="note g">✓ {T('0 doublon · 0 cellule vide', '0 duplicates · 0 empty cells')}</span>
      </div>
      <div class="ly ly2">
        <h4>{T('Chiffre d’affaires mensuel', 'Monthly revenue')}</h4>
        <div class="bars"><i style="--h:42%"><span>{T('Janv', 'Jan')}</span></i><i style="--h:55%"><span>{T('Févr', 'Feb')}</span></i><i style="--h:48%"><span>{T('Mars', 'Mar')}</span></i><i style="--h:66%"><span>{T('Avr', 'Apr')}</span></i><i style="--h:74%"><span>{T('Mai', 'May')}</span></i><i style="--h:88%"><span>{T('Juin', 'Jun')}</span></i></div>
      </div>
      <div class="ly ly3">
        <div class="dg">
          <h4>{T('Tableau de bord · lundi 8 h', 'Dashboard · Monday 8 am')}</h4>
          <div class="t"><small>{T('CA du mois', 'Revenue')}</small><b>48,2 k€</b><em>▲ 12 %</em></div>
          <div class="t"><small>Clients</small><b>128</b><em>▲ 9</em></div>
          <div class="t"><small>{T('Panier moyen', 'Avg. basket')}</small><b>376 €</b><em>▲ 4 %</em></div>
          <div class="w"><svg viewBox="0 0 200 60"><polyline fill="none" stroke="var(--acc)" stroke-width="2.5" points="0,48 25,44 50,46 75,36 100,38 125,28 150,24 175,16 200,10" /><polyline fill="none" stroke="var(--line2)" stroke-width="1.5" stroke-dasharray="4 4" points="0,40 200,40" /></svg></div>
          <div class="d"><svg viewBox="0 0 42 42" width="84" height="84"><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--line)" stroke-width="6" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc)" stroke-width="6" stroke-dasharray="64 36" transform="rotate(-90 21 21)" /><circle cx="21" cy="21" r="15.9" fill="none" stroke="var(--acc2)" stroke-width="6" stroke-dasharray="22 78" stroke-dashoffset="-64" transform="rotate(-90 21 21)" /></svg></div>
        </div>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  (function(){var sec=document.getElementById('story');if(!sec)return;var st=sec.querySelector('.stage'),li=sec.querySelectorAll('.st li'),cap=sec.querySelector('.cap');
    var caps=['ventes_mars_FINAL_v3(2).xlsx','ventes_mars_propre.csv','ca_mensuel.pbix','dashboard · live'];
    function upd(){var r=sec.getBoundingClientRect(),h=sec.offsetHeight-innerHeight,p=h>0?Math.min(1,Math.max(0,-r.top/h)):1,k=Math.min(3,Math.floor(p*4.2));
      st.style.setProperty('--p',p.toFixed(3));if(st.dataset.step!=String(k)){st.dataset.step=k;cap.textContent=caps[k];li.forEach(function(e,i){e.classList.toggle('on',i===k)})}}
    if(matchMedia('(prefers-reduced-motion: reduce)').matches){st.dataset.step=3;cap.textContent=caps[3];li.forEach(function(e){e.classList.add('on')});return}
    addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd()})();
</script>

{!vitrine && (
<section class="sec" id="jeu" style="padding-top:0">
  <div class="wrap">
    <a class="card gamebox rv" href={r('game', lang)}>
      <div class="gb-art" aria-hidden="true">🏡<span>🧑‍💼</span></div>
      <div>
        <div class="kicker">{T('Une pause ?', 'Need a break?')}</div>
        <h3>{T('Le Village des Données', 'Data Village')}</h3>
        <p class="mute">{T('Un petit RPG en 8-bit : aidez un village à gérer son eau, ses loyers et ses dépenses, et croisez au passage les étapes de mon parcours.', 'A tiny 8-bit RPG: help a village manage its water, rents and spending, and meet the steps of my journey along the way.')}</p>
      </div>
      <span class="btn s sm">{T('Jouer', 'Play')} →</span>
    </a>
  </div>
</section>
)}

{!vitrine && (
<section class="sec">
  <div class="wrap">
    <div class="pick rv">
      <div class="pick-top">
        <p class="pick-q">{T('Vous êtes…', 'You are…')}</p>
        <div class="pick-tabs" role="tablist">{doors.map((d, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><span aria-hidden="true">{d.e}</span>{d.s}</button>)}</div>
      </div>
      {doors.map((d, i) => <div class:list={['pick-p', { on: i === 0 }]} data-i={i} role="tabpanel"><div><h3>{d.h}</h3><p class="mute">{d.p}</p></div><a class="btn p" href={d.to}>{d.c} →</a></div>)}
    </div>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('.pick').forEach(function(pk){var bs=pk.querySelectorAll('.pick-tabs button'),ps=pk.querySelectorAll('.pick-p');
    bs.forEach(function(b){b.addEventListener('click',function(){bs.forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false')});ps.forEach(function(p){p.classList.toggle('on',p.dataset.i===b.dataset.i)})})})});
</script>
)}

<section class="sec">
  <div class="wrap">
    <div class="head"><div><div class="kicker">{T('Résultats', 'Results')}</div><h2>{T('Ce que ça a donné.', 'What it delivered.')}</h2></div></div>
    <div class="kpis">
      {results.map((x, i) => <div class="card kpi rv"><div class="viz" set:html={lang === 'en' ? viz[i].replace('AVANT', 'BEFORE').replace('APRÈS', 'AFTER') : viz[i]} /><div class:list={['v', { sm: x.v.length > 7 }]}>{x.v}</div><div class="l">{x.l}</div><div class="c">{x.c}</div></div>)}
    </div>
  </div>
</section>

<section class="sec" id="work">
  <div class="wrap">
    <div class="head"><div><div class="kicker">{T('Réalisations', 'Work')}</div><h2>{T('Des études de cas, avec les dashboards à tester.', 'Case studies, with live dashboards to try.')}</h2></div>{!vitrine && <a class="btn s" href={r('work', lang)}>{ui.common.allProjects[lang]} →</a>}</div>
    <div class="grid g3">
      {(vitrine ? projects : featured).map(p => <ProjectCard p={p} lang={lang} vitrine={vitrine} />)}
    </div>
  </div>
</section>

{!vitrine && (
<section class="sec">
  <div class="wrap">
    <div class="head"><div><div class="kicker">{T('Offres', 'Pricing')}</div><h2>{T('Trois façons de travailler ensemble.', 'Three ways to work together.')}</h2></div><p class="mute">{T('Des forfaits clairs, un prix annoncé d’avance, un livrable que vous gardez.', 'Clear packs, an upfront price, a deliverable you keep.')}</p></div>
    <Pricing lang={lang} compact />
    <div style="margin-top:14px"><a class="btn s" href={r('pricing', lang)}>{T('Options, déroulé et questions fréquentes', 'Options, process and FAQ')} →</a></div>
  </div>
</section>
<section class="sec" id="contact">
  <div class="wrap">
    <div class="head"><div><div class="kicker">Contact</div><h2>{T('Parlons de votre projet.', 'Let’s talk about your project.')}</h2></div></div>
    <ContactCard lang={lang} />
  </div>
</section>
)}
